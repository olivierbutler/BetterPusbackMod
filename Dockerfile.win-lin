FROM --platform=linux/amd64 debian:bullseye
#FROM --platform=linux/amd64 debian:bookworm
# Set noninteractive mode for apt
ENV DEBIAN_FRONTEND=noninteractive

RUN rm -rf /usr/share/man/* \
 && echo 'path-exclude /usr/share/man/*' > /etc/dpkg/dpkg.cfg.d/exclude_manpages

# Debian 11 (bullseye) left security support in August 2026. Its live mirrors
# now list bullseye-security packages whose files have been removed, so
# "apt-get install" fails with 404 errors. Read bullseye from
# snapshot.debian.org at a fixed date instead: a consistent archive that keeps
# every file, and a reproducible build. To use another date:
#   docker build --build-arg DEBIAN_SNAPSHOT=20260801T000000Z ...
ARG DEBIAN_SNAPSHOT=20260901T000000Z
RUN printf 'deb http://snapshot.debian.org/archive/debian/%s bullseye main\n\
deb http://snapshot.debian.org/archive/debian/%s bullseye-updates main\n\
deb http://snapshot.debian.org/archive/debian-security/%s bullseye-security main\n' \
    "$DEBIAN_SNAPSHOT" "$DEBIAN_SNAPSHOT" "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list

# Install base system and cross-compilation dependencies
# (snapshot Release files are past their Valid-Until date, hence the option)
RUN apt-get -o Acquire::Check-Valid-Until=false update && apt-get install -y \
    build-essential \
    cmake \
    zip \
    gettext \
    git \
    libgl1-mesa-dev \
    qt5-qmake \
    qtbase5-dev \
    mingw-w64 \
    gcc-mingw-w64 \
    g++-mingw-w64 \
    libz-mingw-w64-dev \
    pkg-config \
    libasound2-dev \
    portaudio19-dev \
    libpulse-dev \
    libsoundio-dev \
    libx11-dev \
    libxcursor-dev \
    && rm -rf /var/lib/apt/lists/*

# Make sure we use the POSIX variant by default
#RUN update-alternatives \
#    --set x86_64-w64-mingw32-gcc /usr/bin/x86_64-w64-mingw32-gcc-posix && \
#    update-alternatives \
#    --set x86_64-w64-mingw32-g++ /usr/bin/x86_64-w64-mingw32-g++-posix

WORKDIR /xpl_dev

