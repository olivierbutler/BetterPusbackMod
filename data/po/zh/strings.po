msgstr  "停止推車計劃"

msgid "Connect tug before entering pushback plan"
#msgstr "先连接推钩，再开始推车计划"
msgstr  "先連接推鉤，再開始推車計劃"

msgid "Pre-plan pushback"
#msgstr "开始设计推车计划"
msgstr  "開始設計推車計劃"

msgid "Close pushback planner"
#msgstr "关闭推车计划"
msgstr  "關閉推車計劃"

